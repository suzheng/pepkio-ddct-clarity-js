{
  "name": "pepkio-ddct-clarity",
  "version": "0.1.0",
  "description": "qPCR ΔΔCt calculator with transparent error propagation, Pfaffl efficiency correction, plate QC heatmap, and publication-ready fold-change charts via the Pepkio REST API.",
  "readme": "README_NPM.md",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-ddct-clarity": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_NPM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-ddct-clarity-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-ddct-clarity-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/ddct-clarity",
  "keywords": [
    "ddct-clarity",
    "qpcr",
    "gene-expression",
    "ddct",
    "delta-delta-ct",
    "fold-change",
    "pcr",
    "livak",
    "pfaffl",
    "plate-qc",
    "pepkio",
    "laboratory-tools",
    "life-sciences",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  }
}
